---
// The polar opposite of the man page: the same information in a modern, polished layout,
// with the Minster's glass as its one illustration. Served at /pro.
// Nothing on the default site links here, and search engines are asked not to index it.
import { groups, upcoming, groupById, groupsOf, hostName, news, fetchedAt, fmt, mapLink, slug } from '../lib/york';
import type { Event, Group } from '../lib/york';

// Six colours for telling groups apart. Same lightness and strength, different hue.
const hues = ['oklch(72% .15 262)', 'oklch(72% .15 300)', 'oklch(78% .13 75)', 'oklch(76% .13 160)', 'oklch(72% .15 355)', 'oklch(76% .11 215)'];
const colour = (g: Group) => hues[Math.max(groups.indexOf(g), 0) % hues.length];
// A two-letter badge per group: "Code and Coffee" is CC, "York Ruby" is RU.
const skip = new Set(['york', 'and', "n'", 'in', 'of', 'the']);
const badge = (g: Group) => {
  const words = g.name.replace(/([a-z])([A-Z])/g, '$1 $2').split(/[\s-]+/).filter(w => !skip.has(w.toLowerCase()));
  return (words.length > 1 ? words[0][0] + words[1][0] : (words[0] ?? g.name).slice(0, 2)).toUpperCase();
};

const events = upcoming();
const regulars = [...Map.groupBy(events.filter(e => e.series), e => `${e.group}|${e.title}`).values()];
const oneOffs = events.filter(e => !e.series);
const busy = new Set(events.flatMap(e => groupsOf(e).map(g => g.id)));
const nextFor = new Map<string, string>();
for (const e of events) for (const g of groupsOf(e)) if (!nextFor.has(g.id)) nextFor.set(g.id, e.start);
const active = groups.filter(g => busy.has(g.id)).sort((a, b) => nextFor.get(a.id)!.localeCompare(nextFor.get(b.id)!));
const resting = groups.filter(g => !g.retired && !busy.has(g.id) && g.id !== 'yorkdevelopers');
const retired = groups.filter(g => g.retired);
const time = (iso: string) => fmt(iso, { hour: '2-digit', minute: '2-digit' });
const title = (e: Event) => e.title.replace(/^\[[^\]]*\]\s*/, '');
// The card on the page that shows an event: its own, or the weekly card for a regular.
const cardFor = (e: Event) => e.series ? `reg-${slug(regulars.find(items => items.includes(e))![0])}` : `ev-${slug(e)}`;

// Line icons, drawn on a 24px grid.
const paths = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  arrow: '<path d="M7 17 17 7M9 7h8v8"/>',
  left: '<path d="m14.5 6-6 6 6 6"/>',
  right: '<path d="m9.5 6 6 6-6 6"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21"/>',
  plus: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M12 8v8M8 12h8"/>',
  users: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.6c2.8.2 5 2.1 5 5.4"/>',
  shield: '<path d="M12 3l7 3v5.5c0 4.3-2.9 7.7-7 9.5-4.1-1.8-7-5.2-7-9.5V6z"/><path d="m9 12 2.2 2.2L15 10"/>',
};
const icon = (name: keyof typeof paths) =>
  `<svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name]}</svg>`;

// The rose window: rings of glass panes, drawn as wedges with a thin gap between them for the lead.
// The glass keeps to blues and violets, with amber only at the points of the compass.
const glass = ['oklch(62% .17 262)', 'oklch(70% .14 250)', 'oklch(60% .17 285)', 'oklch(74% .11 225)', 'oklch(56% .16 270)', 'oklch(68% .15 300)'];
const amber = 'oklch(82% .13 80)';
const pt = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(1)} ${(r * Math.sin(a)).toFixed(1)}`;
const ring = (n: number, r1: number, r2: number, step: number, gold: number) => Array.from({ length: n }, (_, i) => {
  const gap = 1.3 / r2, a0 = (i / n) * 2 * Math.PI + gap, a1 = ((i + 1) / n) * 2 * Math.PI - gap;
  return {
    d: `M${pt(r1, a0)}L${pt(r2, a0)}A${r2} ${r2} 0 0 1 ${pt(r2, a1)}L${pt(r1, a1)}A${r1} ${r1} 0 0 0 ${pt(r1, a0)}Z`,
    fill: gold && i % gold === 0 ? amber : glass[(i * step) % glass.length], delay: ((i * 37) % 23) / 3,
  };
});
const rings = [ring(12, 28, 84, 1, 0), ring(24, 90, 146, 5, 6), ring(24, 152, 204, 1, 0)];
const studs = Array.from({ length: 24 }, (_, i) => ({ a: ((i + .5) / 24) * 2 * Math.PI, fill: i % 6 === 0 ? amber : glass[(i * 5) % glass.length] }));
const lancet = (x: number, w: number, top: number, foot: number) => `M${x} ${foot}V${top + 44}Q${x} ${top + 16} ${x + w / 2} ${top}Q${x + w} ${top + 16} ${x + w} ${top + 44}V${foot}Z`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>York Developers</title>
  <link rel="icon" href="/img/favicon-32x32.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="nav">
    <a class="brand" href="#top">York Developers</a>
    <nav>
      <a href="#events">Events</a><a href="#groups">Groups</a><a href="#news">News</a><a href="#join">Get involved</a>
    </nav>
    <a class="plain" href="/">Default site</a>
  </header>

  <main id="top">
    <section class="hero">
      <div class="hero-text">
        <h1>York’s tech scene</h1>
        <p class="lede">Every developer meetup in the city, gathered from the groups’ own listings and refreshed twice a day.</p>
        <p class="trust"><Fragment set:html={icon('shield')} />York Developers has supported the city’s tech community since 2017, and is a registered charity.</p>
        <div class="cta">
          <a class="btn solid" href="#events">See what’s on</a>
          <a class="btn" href="/events.ics"><Fragment set:html={icon('calendar')} />Subscribe to the calendar</a>
        </div>

        <a class="next card glow" id="next" href="#events" hidden>
          <span class="next-label" id="next-state">Next up</span>
          <strong id="next-title"></strong>
          <span id="next-meta"></span>
        </a>
      </div>

      <div class="window" aria-hidden="true">
        {[true, false].map(bloom => (
          <svg viewBox="0 0 520 700" class:list={{ bloom }}>
            <defs>
              <linearGradient id={`stone${bloom}`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2f3542" /><stop offset="1" stop-color="#191c24" /></linearGradient>
              <pattern id={`courses${bloom}`} width="46" height="24" patternUnits="userSpaceOnUse">
                <path d="M0 .5H46M0 12.5H46M12 0V12M35 12V24" stroke="#000" stroke-opacity=".3" stroke-width=".8" fill="none" />
              </pattern>
            </defs>
            <g class="stone">
              <!-- the gable wall, laid in fine courses, with a moulded edge -->
              <path d="M30 700V300Q30 70 260 12Q490 70 490 300V700Z" fill={`url(#stone${bloom})`} />
              <path d="M30 700V300Q30 70 260 12Q490 70 490 300V700Z" fill={`url(#courses${bloom})`} />
              <path d="M30 700V300Q30 70 260 12Q490 70 490 300V700" fill="none" stroke="#6f7a90" stroke-width="2" />
              <path d="M42 700V302Q42 82 260 27Q478 82 478 302V700" fill="none" stroke="#6f7a90" stroke-opacity=".35" />
              <!-- the rose's stone ring: three mouldings -->
              <circle cx="260" cy="232" r="188" fill="#22262f" stroke="#6f7a90" stroke-width="2" />
              <circle cx="260" cy="232" r="180" fill="none" stroke="#6f7a90" stroke-opacity=".45" />
              <circle cx="260" cy="232" r="172" fill="#39404d" />
              <!-- a string course and sill for the lancets -->
              <path d="M52 438H468M70 676H450" stroke="#6f7a90" stroke-opacity=".5" stroke-width="2" />
            </g>
            <g transform="translate(260 232) scale(.69)">
              {rings.map(panes => <g class="panes">{panes.map(p => <path d={p.d} fill={p.fill} style={`animation-delay:-${p.delay}s`} />)}</g>)}
              {studs.map(s => <circle cx={(226 * Math.cos(s.a)).toFixed(1)} cy={(226 * Math.sin(s.a)).toFixed(1)} r="9" fill={s.fill} />)}
              <circle r="22" fill={amber} />
            </g>
            {[0, 1, 2, 3, 4].map(i => {
              const x = 88 + i * 72, d = lancet(x, 56, 456, 668);
              return (
                <g>
                  <linearGradient id={`lancet${i}${bloom}`} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color={glass[(i + 1) % glass.length]} /><stop offset="1" stop-color={glass[(i + 4) % glass.length]} />
                  </linearGradient>
                  <path class="panes lancet" d={d} fill={`url(#lancet${i}${bloom})`} style={`animation-delay:-${i * 1.7}s`} />
                  <g class="stone">
                    <path d={`M${x + 28} 462V668M${x} 508H${x + 56}M${x} 540H${x + 56}M${x} 572H${x + 56}M${x} 604H${x + 56}M${x} 636H${x + 56}`} stroke="#12151b" stroke-width="1.3" />
                    <path d={d} fill="none" stroke="#6f7a90" stroke-width="2.5" />
                    <path d={lancet(x - 6, 68, 446, 668)} fill="none" stroke="#6f7a90" stroke-opacity=".4" />
                  </g>
                </g>
              );
            })}
          </svg>
        ))}
      </div>
    </section>

    <section id="events">
      <h2 class="reveal">What’s on</h2>
      <div class="chips reveal" role="group" aria-label="Show events from">
        <button class="chip on" data-g="">All groups</button>
        {active.map(g => <button class="chip" data-g={g.id} style={`--c:${colour(g)}`}><i class="dot"></i>{g.name}</button>)}
      </div>

      <div class="whatson">
      <aside class="cal card reveal" id="cal" aria-label="Month calendar">
        <div class="cal-head">
          <strong id="cal-title"></strong>
          <span>
            <button id="cal-prev" type="button" aria-label="Previous month"><Fragment set:html={icon('left')} /></button>
            <button id="cal-next" type="button" aria-label="Next month"><Fragment set:html={icon('right')} /></button>
          </span>
        </div>
        <div class="cal-grid" id="cal-grid"></div>
        <p class="cal-key"><i class="k has"></i>Event<i class="k dotted"></i>Weekly meetup</p>
      </aside>
      <div>
      {regulars.length > 0 && (
        <div class="weekly">
          {regulars.map(items => {
            const e = items[0], g = groupById(e.group);
            return (
              <a class="card glow reveal regular" id={`reg-${slug(e)}`} href={e.url} data-groups={g.id} data-end={items.at(-1)!.end} style={`--c:${colour(g)}`}>
                <span class="mono">{badge(g)}</span>
                <span>
                  <span class="every">Every {fmt(e.start, { weekday: 'long' })}, {time(e.start)} to {time(e.end)}</span>
                  <strong>{title(e).replace(/\s*\((Mon|Wednes)day\)$/, '').replace(/^Weekly Tech Social - /, '')}</strong>
                  <span class="at"><Fragment set:html={icon('pin')} />{e.venue}</span>
                </span>
              </a>
            );
          })}
        </div>
      )}

      <div class="list" id="list">
        {oneOffs.map(e => {
          const gs = groupsOf(e), g = gs[0];
          return (
            <article class="event card glow reveal" id={`ev-${slug(e)}`} data-start={e.start} data-end={e.end} data-groups={gs.map(x => x.id).join(' ')}
              style={`--c:${colour(g)};view-transition-name:ev-${slug(e)}`}>
              <div class="date">
                <span>{fmt(e.start, { weekday: 'short' })}</span>
                <b>{fmt(e.start, { day: 'numeric' })}</b>
                <span>{fmt(e.start, { month: 'short' })}</span>
              </div>
              <div class="body">
                <span class="host"><i class="dot"></i>{hostName(e)} <i class="live" hidden>On now</i></span>
                <h3><a href={e.url}>{title(e)}</a></h3>
                <p class="meta">
                  <span><Fragment set:html={icon('clock')} />{time(e.start)} to {time(e.end)}</span>
                  {e.venue && <a href={mapLink(e)}><Fragment set:html={icon('pin')} />{e.venue}</a>}
                </p>
                {e.summary && <p class="sum">{e.summary}</p>}
                <p class="acts">
                  <a class="btn small solid" href={e.url}>Event page<Fragment set:html={icon('arrow')} /></a>
                  <a class="link" href={`/events/${slug(e)}.ics`}><Fragment set:html={icon('calendar')} />Add to calendar</a>
                </p>
              </div>
            </article>
          );
        })}
      </div>
      <p class="empty" id="empty" hidden>Nothing listed for this group yet. New events appear here the morning after they’re announced.</p>
      </div>
      </div>
    </section>

    <section id="groups">
      <h2 class="reveal">The groups</h2>
      <div class="tiles">
        {active.map(g => (
          <a class="tile card glow reveal" href={g.url} style={`--c:${colour(g)}`}>
            <span class="mono">{badge(g)}</span>
            <strong>{g.name}</strong>
            <span class="about">{g.about.replace(/\.$/, '')}</span>
            <span class="when"><i class="dot on"></i>Next: {fmt(nextFor.get(g.id)!, { weekday: 'short', day: 'numeric', month: 'short' })}</span>
          </a>
        ))}
      </div>
      <p class="quiet reveal">
        Between events:{' '}
        {resting.map((g, i) => <>{i > 0 && ', '}<a href={g.url}>{g.name}</a></>)}.
        Retired, with thanks: {retired.map(g => g.name).join(', ')}.
      </p>
    </section>

    {news.length > 0 && (
      <section id="news">
        <h2 class="reveal">In the news</h2>
        <ul class="stories">
          {news.slice(0, 6).map(n => (
            <li class="reveal">
              <a href={n.url}>{n.title}</a>
              <span>{n.source}, {fmt(n.date, { day: 'numeric', month: 'short' })}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="join">
      <h2 class="reveal">Get involved</h2>
      <div class="tiles three">
        <a class="tile card glow reveal" href="mailto:code@yorkdevelopers.org?subject=I'd%20like%20to%20give%20a%20talk">
          <span class="ico"><Fragment set:html={icon('mic')} /></span><strong>Give a talk</strong><span class="about">Every group is looking for speakers, first-timers included. Email us and we’ll find you a slot.</span>
        </a>
        <a class="tile card glow reveal" href="https://github.com/yorkdevelopers/yorkdevelopers.github.io/blob/master/groups.yml">
          <span class="ico"><Fragment set:html={icon('plus')} /></span><strong>List your group</strong><span class="about">Add it to groups.yml with a pull request, and its events appear here on the next refresh.</span>
        </a>
        <a class="tile card glow reveal" href="https://www.meetup.com/yorkdevelopers/">
          <span class="ico"><Fragment set:html={icon('users')} /></span><strong>Start a group</strong><span class="about">Come to Code and Coffee and ask. We can help with a room, a first speaker and an audience.</span>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <div class="links">
      <a href="mailto:code@yorkdevelopers.org">code@yorkdevelopers.org</a>
      <a href="https://www.meetup.com/yorkdevelopers/">Meetup</a>
      <a href="https://github.com/yorkdevelopers">GitHub</a>
      <a href="https://www.facebook.com/groups/yorkdevelopers">Facebook</a>
      <a href="https://www.linkedin.com/company/18066526">LinkedIn</a>
      <a href="https://x.com/YorkDevelopers">X</a>
      <a href="/events.ics">Calendar feed</a>
      <a href="/feed.xml">RSS</a>
      <a href="/about/">About</a>
      <a href="/code-of-conduct/">Code of conduct</a>
    </div>
    <p>York Developers is a Charitable Incorporated Organisation, registered charity 1177591. Events checked {fmt(fetchedAt, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}.</p>
  </footer>

  <script type="application/json" id="data" set:html={JSON.stringify(events.map(e => ({ t: title(e), s: e.start, e: e.end, h: hostName(e), v: e.venue ?? '', r: !!e.series, k: cardFor(e) })))} />
</body>
</html>

<style is:global>
  /* A neutral near-black base, white text and one cobalt accent. Colour beyond that is kept
     to the window and to a small dot or badge that says which group something belongs to. */
  :root {
    --base: #0a0c10; --raised: #12151b; --line: #232833; --line-hi: #343b49;
    --ink: #f3f5f9; --subtext: #9aa3b3;
    --accent: oklch(62% .19 264); --accent-hi: oklch(74% .14 264); --green: oklch(76% .14 160);
    --font: 'Geist', system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 84px; }
  body { margin: 0; color: var(--ink); font: 400 16px/1.55 var(--font); -webkit-font-smoothing: antialiased;
    background: radial-gradient(1100px 620px at 78% -8%, oklch(62% .19 264 / .17), transparent 70%) no-repeat var(--base); }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 3px; border-radius: 4px; }
  .i { width: 1.05em; height: 1.05em; flex: none; vertical-align: -.16em; }

  .nav { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: 28px; padding: 14px max(20px, calc(50vw - 570px));
    background: rgba(10, 12, 16, .78); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .brand { font-weight: 600; text-decoration: none; letter-spacing: -.01em; }
  .nav nav { display: flex; gap: 24px; margin-left: auto; }
  .nav a { text-decoration: none; }
  .nav nav a, .plain { color: var(--subtext); font-size: .93rem; transition: color .15s; }
  .nav nav a:hover, .plain:hover { color: var(--ink); }
  .plain { padding-left: 24px; border-left: 1px solid var(--line); }

  main, footer { width: min(1140px, calc(100% - 40px)); margin: 0 auto; }
  section { padding: 64px 0 8px; }
  h2 { font-size: clamp(1.5rem, 2.6vw, 1.95rem); font-weight: 600; letter-spacing: -.025em; margin: 0 0 22px; }

  /* hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); align-items: center; gap: 48px; padding-top: 56px; }
  h1 { font-size: clamp(2.6rem, 5.6vw, 4.5rem); font-weight: 700; line-height: 1.02; letter-spacing: -.04em; margin: 0 0 20px; }
  .lede { font-size: 1.18rem; color: var(--subtext); max-width: 40ch; margin: 0 0 14px; }
  .trust { display: flex; gap: 9px; align-items: flex-start; color: var(--subtext); font-size: .93rem; max-width: 46ch; margin: 0 0 28px; }
  .trust .i { color: var(--green); margin-top: .2em; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 32px; }
  .btn { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 500; font-size: .95rem; padding: 10px 16px; border-radius: 8px; border: 1px solid var(--line-hi); transition: background .15s, border-color .15s; }
  .btn:hover { background: var(--raised); border-color: var(--subtext); }
  .btn.solid { background: var(--accent); color: #fff; border-color: transparent; }
  .btn.solid:hover { background: oklch(57% .19 264); }
  .btn.small { padding: 7px 12px; font-size: .88rem; }
  .link { display: inline-flex; align-items: center; gap: 7px; color: var(--subtext); font-size: .88rem; text-decoration: none; }
  .link:hover { color: var(--ink); }

  .card { position: relative; border-radius: 12px; background: var(--raised); border: 1px solid var(--line); overflow: hidden; }
  .card > * { position: relative; }
  /* a soft pool of light under the pointer */
  .glow::before { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .25s;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, .06), transparent 65%); }
  .glow:hover::before { opacity: 1; }
  .glow { transition: border-color .2s; }
  .glow:hover { border-color: var(--line-hi); }

  .next { display: grid; gap: 3px; max-width: 480px; padding: 16px 18px; text-decoration: none; }
  .next-label { color: var(--accent-hi); font-weight: 500; font-size: .85rem; }
  .next strong { font-size: 1.1rem; font-weight: 600; letter-spacing: -.015em; line-height: 1.25; }
  .next > span:last-child { color: var(--subtext); font-size: .93rem; }

  /* the window: a rose set in stone above five lancets */
  .window { position: relative; aspect-ratio: 52 / 70; max-height: 74vh; justify-self: center; width: min(100%, 440px); }
  .window svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  /* a blurred copy of the glass alone, so its colour spills softly past the stone */
  .window svg.bloom { filter: blur(46px); opacity: .5; }
  .window svg.bloom .stone { display: none; }
  .panes path, path.panes { animation: shimmer 7s ease-in-out infinite alternate; }
  @keyframes shimmer { from { opacity: .78; } to { opacity: 1; } }

  /* events */
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--c, var(--subtext)); margin-right: 8px; flex: none; }
  .dot.on { background: var(--green); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .chip { display: inline-flex; align-items: center; font: 500 .88rem var(--font); color: var(--subtext); padding: 7px 12px; border-radius: 8px; cursor: pointer; background: none; border: 1px solid var(--line); transition: color .15s, border-color .15s, background .15s; }
  .chip:hover { color: var(--ink); border-color: var(--line-hi); }
  .chip.on { color: var(--ink); background: var(--raised); border-color: var(--subtext); }
  .mono { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; font-size: .78rem; font-weight: 600; letter-spacing: .02em; flex: none;
    color: var(--c, var(--ink)); background: color-mix(in srgb, var(--c, var(--ink)) 13%, transparent); border: 1px solid color-mix(in srgb, var(--c, var(--ink)) 30%, transparent); }
  .weekly { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin-bottom: 12px; }
  .regular { display: flex; gap: 14px; align-items: flex-start; padding: 16px 18px; text-decoration: none; }
  .regular > span:last-child { display: grid; gap: 2px; }
  .every { color: var(--subtext); font-size: .85rem; }
  .regular strong { font-weight: 600; font-size: 1.05rem; letter-spacing: -.01em; }
  .at { color: var(--subtext); font-size: .9rem; display: flex; gap: 6px; align-items: center; }
  .list { display: grid; gap: 12px; }
  .event { display: grid; grid-template-columns: 86px 1fr; box-shadow: inset 3px 0 0 var(--c); }
  .date { display: grid; align-content: center; justify-items: center; padding: 18px 0; color: var(--subtext); font-size: .8rem; font-weight: 500; border-right: 1px solid var(--line); }
  .date b { font-size: 1.75rem; font-weight: 600; line-height: 1.1; letter-spacing: -.03em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .body { padding: 16px 20px 18px; }
  .host { display: flex; align-items: center; color: var(--subtext); font-size: .85rem; font-weight: 500; }
  .live { font-style: normal; margin-left: 10px; padding: 1px 8px; border-radius: 6px; background: color-mix(in srgb, var(--green) 16%, transparent); color: var(--green); font-size: .78rem; }
  h3 { font-size: clamp(1.1rem, 1.8vw, 1.3rem); font-weight: 600; line-height: 1.25; letter-spacing: -.02em; margin: 4px 0 8px; }
  h3 a { text-decoration: none; } h3 a:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0 0 8px; color: var(--subtext); font-size: .92rem; }
  .meta > * { display: inline-flex; align-items: center; gap: 6px; }
  .meta a { text-decoration: none; } .meta a:hover { color: var(--ink); }
  .sum { margin: 0 0 14px; color: var(--subtext); font-size: .95rem; max-width: 78ch; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .acts { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin: 0; }
  .empty { color: var(--subtext); }

  /* list on the left, month calendar on the right */
  .whatson { display: grid; grid-template-columns: minmax(0, 1fr) 286px; gap: 20px; align-items: start; }
  .whatson > aside { order: 2; position: sticky; top: 84px; }
  .cal { padding: 16px; }
  .cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .cal-head strong { font-weight: 600; font-size: .95rem; }
  .cal-head button { background: none; border: 1px solid var(--line); color: var(--subtext); border-radius: 6px; width: 28px; height: 28px; cursor: pointer; margin-left: 4px; display: inline-grid; place-items: center; }
  .cal-head button:hover:not(:disabled) { color: var(--ink); border-color: var(--line-hi); }
  .cal-head button:disabled { opacity: .3; cursor: default; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 3px; text-align: center; font-size: .82rem; font-variant-numeric: tabular-nums; }
  .cal-grid .wd { color: var(--subtext); font-size: .72rem; padding-bottom: 4px; }
  .cal-grid .d { height: 32px; min-width: 0; display: grid; place-items: center; border-radius: 7px; border: 1px solid transparent; color: var(--subtext); background: none; font: inherit; padding: 0; position: relative; }
  .cal-grid .past { opacity: .35; }
  .cal-grid .today { border-color: var(--subtext); color: var(--ink); }
  .cal-grid button.d { cursor: pointer; color: var(--ink); }
  .cal-grid .has { background: color-mix(in srgb, var(--accent) 30%, transparent); border-color: color-mix(in srgb, var(--accent) 70%, transparent); font-weight: 600; }
  .cal-grid .has:hover { background: color-mix(in srgb, var(--accent) 50%, transparent); }
  .cal-grid .dotted::after, .k.dotted { content: ''; width: 4px; height: 4px; border-radius: 50%; background: var(--accent-hi); }
  .cal-grid .dotted::after { position: absolute; bottom: 3px; left: calc(50% - 2px); }
  .cal-grid button.dotted:hover { border-color: var(--line-hi); }
  .cal-key { display: flex; align-items: center; gap: 7px; margin: 12px 0 0; color: var(--subtext); font-size: .78rem; }
  .k { display: inline-block; }
  .k.has { width: 10px; height: 10px; border-radius: 3px; background: color-mix(in srgb, var(--accent) 30%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 70%, transparent); }
  .k.dotted { margin-left: 10px; }
  .flash { outline: 2px solid var(--accent-hi); outline-offset: 2px; }

  /* groups */
  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 12px; }
  .tiles.three { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .tile { display: grid; gap: 6px; align-content: start; padding: 20px; text-decoration: none; min-height: 168px; }
  .tile .mono, .ico { margin-bottom: 8px; }
  .ico { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 8px; border: 1px solid var(--line-hi); color: var(--accent-hi); font-size: 1.1rem; }
  .tile strong { font-weight: 600; font-size: 1.05rem; letter-spacing: -.01em; }
  .about { color: var(--subtext); font-size: .92rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .when { margin-top: auto; padding-top: 10px; display: flex; align-items: center; color: var(--subtext); font-size: .85rem; }
  .quiet { color: var(--subtext); font-size: .93rem; margin-top: 20px; max-width: 86ch; }
  .quiet a { text-decoration-color: var(--line-hi); text-underline-offset: 3px; } .quiet a:hover { color: var(--ink); }

  /* news */
  .stories { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 0 48px; border-top: 1px solid var(--line); }
  .stories li { padding: 14px 0; border-bottom: 1px solid var(--line); }
  .stories a { display: block; font-weight: 500; text-decoration: none; line-height: 1.35; } .stories a:hover { color: var(--accent-hi); }
  .stories span { color: var(--subtext); font-size: .85rem; }

  footer { margin-top: 72px; padding: 28px 0 48px; border-top: 1px solid var(--line); color: var(--subtext); font-size: .9rem; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 16px; }
  .links a { text-decoration: none; color: var(--ink); } .links a:hover { color: var(--accent-hi); }
  footer p { margin: 6px 0; max-width: 92ch; }

  /* panes settle into place as they scroll into view */
  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease, border-color .2s; }
  .reveal.in { opacity: 1; transform: none; }
  [hidden] { display: none !important; }
  ::view-transition-group(*) { animation-duration: .3s; }

  @media (max-width: 860px) {
    .nav nav { display: none; } .plain { margin-left: auto; border: 0; padding: 0; }
    .hero { grid-template-columns: 1fr; gap: 32px; padding-top: 36px; }
    .window { width: min(72vw, 340px); }
    .whatson { grid-template-columns: 1fr; }
    .whatson > aside { order: 0; position: static; max-width: 340px; }
    .event { grid-template-columns: 64px 1fr; } .date b { font-size: 1.45rem; } .body { padding: 14px 16px 16px; }
    section { padding-top: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .panes path, path.panes { animation: none; }
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  const now = () => Date.now();
  const york = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', ...o });

  // a soft light follows the pointer across each card
  document.addEventListener('pointermove', e => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('.glow');
    if (!card) return;
    const r = card.getBoundingClientRect();
    card.style.setProperty('--mx', `${e.clientX - r.left}px`);
    card.style.setProperty('--my', `${e.clientY - r.top}px`);
  });

  const seen = new IntersectionObserver(entries => entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); seen.unobserve(en.target); } }), { threshold: .1 });
  document.querySelectorAll('.reveal').forEach(el => seen.observe(el));

  // drop finished events, mark the ones running now, apply the group filter
  const cards = [...document.querySelectorAll<HTMLElement>('#list .event, .regular')];
  let group = '';
  function show() {
    let any = false;
    for (const card of cards) {
      const current = Date.parse(card.dataset.end!) > now();
      const match = current && (!group || card.dataset.groups!.split(' ').includes(group));
      card.hidden = !match;
      if (match) { any = true; card.classList.add('in'); }
      const live = card.querySelector<HTMLElement>('.live');
      if (live) live.hidden = !(Date.parse(card.dataset.start!) <= now());
    }
    document.getElementById('empty')!.hidden = any;
  }
  document.querySelector('.chips')!.addEventListener('click', e => {
    const chip = (e.target as HTMLElement).closest<HTMLElement>('.chip');
    if (!chip) return;
    group = chip.dataset.g!;
    document.querySelectorAll('.chip').forEach(c => c.classList.toggle('on', c === chip));
    // cards glide to their new places where the browser can do it
    (document as any).startViewTransition ? (document as any).startViewTransition(show) : show();
  });

  // "Starts in 1 h 53 min" for whatever is next
  const all: { t: string; s: string; e: string; h: string; v: string; r: boolean; k: string }[] = JSON.parse(document.getElementById('data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  function next() {
    const ev = all.find(e => Date.parse(e.e) > now());
    $('next').hidden = !ev;
    if (!ev) return;
    const start = Date.parse(ev.s), mins = Math.ceil((start - now()) / 60000);
    const wait = mins >= 2880 ? `in ${Math.floor(mins / 1440)} days` : mins >= 60 ? `in ${Math.floor(mins / 60)} h ${mins % 60} min` : `in ${mins} min`;
    $('next-state').textContent = mins <= 0 ? 'On now' : `Next up, starts ${wait}`;
    $('next-title').textContent = ev.t;
    $('next-meta').textContent = `${ev.h}. ${york({ weekday: 'long', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }).format(start)}${ev.v ? ` at ${ev.v}` : ''}`;
  }
  // the month calendar: days with an event are filled, days with only a weekly meetup get a dot
  const dayKey = york({ year: 'numeric', month: '2-digit', day: '2-digit' });
  const iso = (t: number) => dayKey.format(t).split('/').reverse().join('-');
  const pad = (n: number) => String(n).padStart(2, '0');
  const today = iso(now());
  const byDay = new Map<string, { card: string; weekly: boolean; n: number }>();
  for (const e of all) {
    if (Date.parse(e.e) <= now()) continue;
    const d = iso(Date.parse(e.s)), had = byDay.get(d);
    // a one-off event takes the day over a weekly meetup
    if (!had || (had.weekly && !e.r)) byDay.set(d, { card: e.k, weekly: e.r, n: (had?.n ?? 0) + 1 });
    else had.n++;
  }
  const months = [...new Set([today, ...byDay.keys()].map(d => d.slice(0, 7)))].sort();
  let month = 0;
  function calendar() {
    const [y, m] = months[month].split('-').map(Number);
    const first = new Date(Date.UTC(y, m - 1, 1)), count = new Date(Date.UTC(y, m, 0)).getUTCDate();
    $('cal-title').textContent = first.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
    ($('cal-prev') as HTMLButtonElement).disabled = month === 0;
    ($('cal-next') as HTMLButtonElement).disabled = month === months.length - 1;
    let html = ['M', 'T', 'W', 'T', 'F', 'S', 'S'].map(d => `<span class="wd">${d}</span>`).join('') + '<span></span>'.repeat((first.getUTCDay() + 6) % 7);
    for (let d = 1; d <= count; d++) {
      const key = `${y}-${pad(m)}-${pad(d)}`, hit = byDay.get(key);
      const cls = ['d', key === today && 'today', key < today && 'past', hit && (hit.weekly ? 'dotted' : 'has')].filter(Boolean).join(' ');
      const label = `${d} ${first.toLocaleDateString('en-GB', { month: 'long', timeZone: 'UTC' })}`;
      html += hit ? `<button type="button" class="${cls}" data-go="${hit.card}" aria-label="${label}, ${hit.n} event${hit.n > 1 ? 's' : ''}">${d}</button>` : `<span class="${cls}">${d}</span>`;
    }
    $('cal-grid').innerHTML = html;
  }
  $('cal-prev').addEventListener('click', () => { month--; calendar(); });
  $('cal-next').addEventListener('click', () => { month++; calendar(); });
  // choosing a day jumps to its event in the list
  $('cal-grid').addEventListener('click', e => {
    const id = (e.target as HTMLElement).closest<HTMLElement>('[data-go]')?.dataset.go;
    if (!id) return;
    if (group) document.querySelector<HTMLElement>('.chip[data-g=""]')!.click();
    const card = document.getElementById(id)!;
    card.scrollIntoView({ block: 'center' });
    card.classList.add('flash');
    setTimeout(() => card.classList.remove('flash'), 1600);
  });
  calendar();

  const refresh = () => { show(); next(); };
  refresh();
  setInterval(refresh, 30_000);
</script>
