---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/400-italic.css';
import '@fontsource/ibm-plex-mono/600.css';
import { CSP } from '../lib/york';

// `canonical` is for a page that repeats another one: it names the page search engines should list.
interface Props { name: string; section?: number; title: string; description?: string; canonical?: string; }
const { name, section = 7, title, description = 'Developer meetups and tech events in York, UK.' } = Astro.props;
const ref = `${name.toUpperCase()}(${section})`;
const home = Astro.url.pathname.replace(/\/$/, '') === '/man';
const canonical = new URL(Astro.props.canonical ?? Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  {/* left out while developing, where the dev server needs inline scripts of its own */}
  {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={CSP} />}
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="color-scheme" content="dark light">
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/img/favicon-32x32.png">
  <link rel="alternate" type="text/calendar" title="York tech events" href="/events.ics">
  <link rel="alternate" type="application/rss+xml" title="York tech events" href="/feed.xml">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="York Developers">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={new URL('/og.png', Astro.site)}>
  <meta name="twitter:card" content="summary_large_image">
  <slot name="head" />
  <!-- applies a saved theme before the page paints; without one, the page is dark -->
  <script is:inline src="/theme.js"></script>
</head>
<body>
  <div class="page">
    <div class="top"><a href="/">[ main site ]</a><button id="theme" type="button" hidden></button></div>
    <div class="hdr"><span>{home ? ref : <a href="/man/">YORK(7)</a>}</span><span>York Developers Manual</span><span>{ref}</span></div>
    <slot />
    <div class="ftr"><span>yorkdevelopers.org</span><slot name="footer" /><span>{ref}</span></div>
    <p class="charity">🏵️ York Developers is a Charitable Incorporated Organisation, registered charity 1177591. <a href="/about/">About us</a></p>
  </div>
</body>
</html>

<script>
  const button = document.getElementById('theme') as HTMLButtonElement;
  const root = document.documentElement;
  const current = () => root.dataset.theme ?? 'dark';
  const label = () => { button.textContent = current() === 'dark' ? '[ light mode ]' : '[ dark mode ]'; };
  button.addEventListener('click', () => {
    root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    label();
  });
  label();
  button.hidden = false;
</script>

<style is:global>
  :root { --bg: #1b1e27; --ink: #e8e6df; --muted: #9aa0ad; --link: #9db4ff; --mark: #6b5a00; --rule: #343846; --live: #7bd88f; }
  :root { color-scheme: dark; }
  /* dark is the default for everyone; light only when the visitor picks it with the toggle */
  :root[data-theme="light"] { --bg: #fdfdfb; --ink: #16181d; --muted: #5d646f; --link: #1d3fc4; --mark: #ffe45c; --rule: #d9dbd4; --live: #1a7f37; color-scheme: light; }
  .top { display: flex; justify-content: flex-end; gap: 2ch; min-height: 1.6em; margin-bottom: 6px; }
  .top button, .top a { font: inherit; font-size: .9em; color: var(--muted); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: none; }
  .top button:hover, .top a:hover { color: var(--link); }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 15.5px/1.6 'IBM Plex Mono', ui-monospace, monospace; }
  .page { max-width: 86ch; margin: 0 auto; padding: 22px 2ch 70px; }
  a { color: var(--link); text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .hdr, .ftr { display: flex; justify-content: space-between; gap: 2ch; color: var(--muted); }
  .hdr a { color: inherit; }
  .ftr { margin-top: 36px; }
  .charity { color: var(--muted); font-size: .9em; max-width: none; margin: 14px 0 0; }
  pre { font: inherit; margin: 0; }
  h2 { font-size: 1em; font-weight: 600; margin: 30px 0 4px; }
  section > :not(h2) { margin-left: 8ch; }
  p { margin: 0 0 12px; max-width: 68ch; }
  b, strong { font-weight: 600; }
  i, em { color: var(--muted); }
  dl { display: grid; grid-template-columns: 30ch 1fr; margin-top: 0; margin-bottom: 0; }
  dt, dd { margin: 0; padding: 3px 0; }
  dd { color: var(--muted); }
  code { background: color-mix(in srgb, var(--ink) 9%, transparent); padding: 1px .6ch; }
  kbd { font: inherit; border: 1px solid var(--rule); padding: 0 .6ch; border-radius: 3px; }

  /* long-form pages: news posts, about, code of conduct */
  .prose :is(h1, h2, h3, h4, h5, h6) { font-size: 1em; font-weight: 600; margin: 22px 0 6px; }
  .prose img { max-width: 100%; height: auto; display: block; margin: 12px 0; }
  .prose ul, .prose ol { padding-left: 3ch; max-width: 68ch; }
  .prose pre { overflow-x: auto; border: 1px solid var(--rule); padding: 8px 1.5ch; margin-bottom: 12px; }

  @media (max-width: 640px) {
    section > :not(h2) { margin-left: 0; }
    dl { grid-template-columns: 1fr; }
    dd { padding-bottom: 8px; }
    .hdr span:nth-child(2) { display: none; }
  }
</style>
